{
  "description": "Show local token usage and estimated cost after each root turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/turn-cost.js\"",
            "commandWindows": "node.exe \"${PLUGIN_ROOT}\\scripts\\turn-cost.js\"",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
